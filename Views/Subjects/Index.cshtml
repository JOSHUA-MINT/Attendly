@model List<Attendly.ViewModels.SubjectViewModel>
@{
 ViewData["Title"] = "My Subjects";
 }

<div class="container-fluid px-4 py-4" style="background: #f0f2f5; min-height: 100vh;">
 <div class="d-flex justify-content-between align-items-center mb-4">
 <h2 class="fw-bold"><i class="fas fa-book-open text-primary me-2"></i>My Subjects</h2>
 <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Subject</a>
 </div>

 @if (TempData["Success"] != null)
 {
 <div class="alert alert-success">@TempData["Success"]</div>
 }

 <div class="row g-4">
 @foreach (var subj in Model)
 {
 <div class="col-md-6 col-xl-4">
 <div class="card border-0 shadow-sm h-100">
 <div class="card-body">
 <div class="d-flex justify-content-between align-items-start mb-2">
 <div>
 <h5 class="fw-bold">@subj.Name</h5>
 @if (!string.IsNullOrEmpty(subj.Code))
 {
 <span class="badge bg-secondary">@subj.Code</span>
 }
 </div>
 <div class="dropdown">
 <button class="btn btn-sm btn-light" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v"></i></button>
 <ul class="dropdown-menu">
 <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@subj.Id"><i class="fas fa-edit me-2"></i>Edit</a></li>
 <li><form asp-action="Archive" asp-route-id="@subj.Id" method="post" class="d-inline">
 <button type="submit" class="dropdown-item text-warning"><i class="fas fa-archive me-2"></i>@(subj.IsArchived ? "Restore" : "Archive")</button>
 </form></li>
 <li><hr class="dropdown-divider" /></li>
 <li>
 <form asp-action="Delete" asp-route-id="@subj.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this subject and all attendance records?')">
 <button type="submit" class="dropdown-item text-danger"><i class="fas fa-trash me-2"></i>Delete</button>
 </form>
 </li>
 </ul>
 </div>
 </div>
 <div class="row g-2 mt-1">
 @if (!string.IsNullOrEmpty(subj.Professor))
 {
 <div class="col-12 small text-muted"><i class="fas fa-user-tie me-1"></i> @subj.Professor</div>
 }
 @if (!string.IsNullOrEmpty(subj.Room))
 {
 <div class="col-12 small text-muted"><i class="fas fa-map-marker-alt me-1"></i> @subj.Room</div>
 }
 <div class="col-12 small text-muted"><i class="fas fa-clock me-1"></i> @subj.LecturesPerWeek lectures/week · Target: @subj.TargetPercentage%</div>
 </div>
 <div class="mt-3">
 <a asp-controller="Attendance" asp-action="Index" asp-route-subjectId="@subj.Id" class="btn btn-sm btn-outline-primary w-100">
 <i class="fas fa-clipboard-check me-1"></i>View Attendance
 </a>
 </div>
 </div>
 </div>
 </div>
 }
 </div>

 @if (!Model.Any())
 {
 <div class="text-center py-5">
 <i class="fas fa-book fa-3x text-muted mb-3"></i>
 <h4>No subjects yet</h4>
 <p class="text-muted">Add your first subject to start tracking attendance.</p>
 <a asp-action="Create" class="btn btn-primary">Add First Subject</a>
 </div>
 }
</div>
