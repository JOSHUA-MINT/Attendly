@model Attendly.ViewModels.AdminDashboardViewModel
@{
 ViewData["Title"] = "Admin Dashboard";
 }

<div class="container-fluid px-4 py-4" style="background: #f0f2f5; min-height: 100vh;">
 <h3 class="fw-bold mb-4"><i class="fas fa-shield-alt text-danger me-2"></i>Admin Dashboard</h3>

 <div class="row g-3 mb-4">
 <div class="col-md-3">
 <div class="card border-0 shadow-sm">
 <div class="card-body text-center">
 <h2 class="fw-bold text-primary">@Model.TotalUsers</h2>
 <p class="text-muted mb-0">Total Users</p>
 </div>
 </div>
 </div>
 <div class="col-md-3">
 <div class="card border-0 shadow-sm">
 <div class="card-body text-center">
 <h2 class="fw-bold text-success">@Model.ActiveUsers</h2>
 <p class="text-muted mb-0">Active Users</p>
 </div>
 </div>
 </div>
 <div class="col-md-3">
 <div class="card border-0 shadow-sm">
 <div class="card-body text-center">
 <h2 class="fw-bold text-warning">@Model.PremiumUsers</h2>
 <p class="text-muted mb-0">Premium Users</p>
 </div>
 </div>
 </div>
 <div class="col-md-3">
 <div class="card border-0 shadow-sm">
 <div class="card-body text-center">
 <h2 class="fw-bold text-danger">@Model.PendingReports</h2>
 <p class="text-muted mb-0">Pending Reports</p>
 </div>
 </div>
 </div>
 </div>

 <div class="row g-4">
 <div class="col-lg-6">
 <div class="card border-0 shadow-sm">
 <div class="card-header bg-white border-0 py-3">
 <h5 class="fw-bold mb-0">Recent Reports</h5>
 </div>
 <div class="card-body">
 @if (Model.RecentReports.Any())
 {
 <div class="table-responsive">
 <table class="table">
 <thead>
 <tr>
 <th>Reporter</th>
 <th>Reported</th>
 <th>Reason</th>
 <th>Status</th>
 </tr>
 </thead>
 <tbody>
 @foreach (var report in Model.RecentReports)
 {
 <tr>
 <td>@report.ReporterName</td>
 <td>@report.ReportedUserName</td>
 <td>@report.Reason</td>
 <td><span class="badge bg-@(report.Status == "pending" ? "warning" : report.Status == "actioned" ? "success" : "secondary")">@report.Status</span></td>
 </tr>
 }
 </tbody>
 </table>
 </div>
 }
 else
 {
 <p class="text-muted">No pending reports.</p>
 }
 </div>
 </div>
 </div>
 <div class="col-lg-6">
 <div class="card border-0 shadow-sm">
 <div class="card-header bg-white border-0 py-3">
 <h5 class="fw-bold mb-0">Quick Actions</h5>
 </div>
 <div class="card-body">
 <div class="d-grid gap-2">
 <a asp-action="ManageHolidays" class="btn btn-outline-primary text-start"><i class="fas fa-calendar me-2"></i>Manage Holidays</a>
 <a asp-action="ManageReports" class="btn btn-outline-warning text-start"><i class="fas fa-flag me-2"></i>Review Reports</a>
 </div>
 </div>
 </div>
 </div>
 </div>
</div>
