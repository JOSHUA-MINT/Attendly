@{
 ViewData["Title"] = "Timetable";
 var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
 }

<div class="container-fluid px-4 py-4" style="background: #f0f2f5; min-height: 100vh;">
 <div class="d-flex justify-content-between align-items-center mb-4">
 <h3 class="fw-bold"><i class="fas fa-calendar-alt text-primary me-2"></i>Weekly Timetable</h3>
 <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addEntryModal">
 <i class="fas fa-plus me-1"></i>Add Entry
 </button>
 </div>

 <div class="card border-0 shadow-sm">
 <div class="card-body p-0">
 <div class="table-responsive">
 <table class="table table-bordered mb-0">
 <thead class="table-light">
 <tr>
 <th style="width: 80px;">Time</th>
 @foreach (var day in days)
 {
 <th class="text-center">@day</th>
 }
 </tr>
 </thead>
 <tbody>
 @{
 var times = new[] { "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00" };
 }
 @foreach (var time in times)
 {
 <tr>
 <td class="fw-bold text-muted small">@time</td>
 @foreach (var day in days)
 {
 <td class="align-middle">
 @{
 int dayNum = Array.IndexOf(days, day) + 1;
 var dayData = ViewData[$"day_{day}"] as List<Attendly.Models.TimetableEntry>;
 if (dayData != null)
 {
 var entry = dayData.FirstOrDefault(e => e.StartTime.ToString(@"hh\:mm") == time);
 if (entry != null)
 {
 var subj = (ViewBag.Subjects as List<Attendly.Models.Subject>)?.FirstOrDefault(s => s.Id == entry.SubjectId);
 <div class="p-2 rounded text-white text-center" style="background-color: @(subj?.Color ?? "#3B82F6"); min-height: 50px;">
 <strong class="small">@(subj?.Name ?? "Unknown")</strong>
 <br /><small>@entry.Room</small>
 </div>
 }
 }
 }
 </td>
 }
 </tr>
 }
 </tbody>
 </table>
 </div>
 </div>
 </div>
</div>

<!-- Add Entry Modal -->
<div class="modal fade" id="addEntryModal" tabindex="-1">
 <div class="modal-dialog">
 <div class="modal-content">
 <div class="modal-header">
 <h5 class="modal-title">Add Timetable Entry</h5>
 <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
 </div>
 <form asp-action="Add" method="post">
 <div class="modal-body">
 <div class="mb-3">
 <label class="form-label">Subject</label>
 <select name="subjectId" class="form-select" required>
 <option value="">Select subject</option>
 @foreach (var subj in ViewBag.Subjects as List<Attendly.Models.Subject> ?? new())
 {
 <option value="@subj.Id">@subj.Name</option>
 }
 </select>
 </div>
 <div class="mb-3">
 <label class="form-label">Day</label>
 <select name="dayOfWeek" class="form-select" required>
 <option value="1">Monday</option>
 <option value="2">Tuesday</option>
 <option value="3">Wednesday</option>
 <option value="4">Thursday</option>
 <option value="5">Friday</option>
 <option value="6">Saturday</option>
 <option value="7">Sunday</option>
 </select>
 </div>
 <div class="row">
 <div class="col-6">
 <div class="mb-3">
 <label class="form-label">Start Time</label>
 <input type="time" name="startTime" class="form-control" required />
 </div>
 </div>
 <div class="col-6">
 <div class="mb-3">
 <label class="form-label">End Time</label>
 <input type="time" name="endTime" class="form-control" required />
 </div>
 </div>
 </div>
 <div class="mb-3">
 <label class="form-label">Room (optional)</label>
 <input name="room" class="form-control" />
 </div>
 </div>
 <div class="modal-footer">
 <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
 <button type="submit" class="btn btn-primary">Add Entry</button>
 </div>
 </form>
 </div>
 </div>
</div>
