@{
 ViewData["Title"] = "Features - Attendly";
 }

<section class="hero-section text-white py-5" style="background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);">
 <div class="container text-center">
 <span class="badge bg-warning text-dark mb-3 px-3 py-2">Features</span>
 <h1 class="display-4 fw-bold">Everything You Need to Ace Attendance</h1>
 <p class="lead text-white-50">The complete student platform for attendance management, planning, and campus connections.</p>
 </div>
</section>

<section class="py-5 bg-white">
 <div class="container py-5">
 <div class="row g-5">
 <div class="col-lg-6">
 <div class="d-flex">
 <div class="icon-circle bg-primary text-white me-4"><i class="fas fa-clipboard-check fa-2x"></i></div>
 <div>
 <h4 class="fw-bold">Attendance Tracking</h4>
 <p class="text-muted">Quickly mark present, absent, cancelled, late, or excused for every lecture. Track across all subjects.</p>
 </div>
 </div>
 </div>
 <div class="col-lg-6">
 <div class="d-flex">
 <div class="icon-circle bg-success text-white me-4"><i class="fas fa-chart-pie fa-2x"></i></div>
 <div>
 <h4 class="fw-bold">Smart Analytics</h4>
 <p class="text-muted">Detailed charts, trends, and insights about your attendance patterns. Know your weak subjects instantly.</p>
 </div>
 </div>
 </div>
 <div class="col-lg-6">
 <div class="d-flex">
 <div class="icon-circle bg-info text-white me-4"><i class="fas fa-calculator fa-2x"></i></div>
 <div>
 <h4 class="fw-bold">Can I Skip? Simulator</h4>
 <p class="text-muted">Simulate missing classes and see the real impact on your attendance before you decide to skip.</p>
 </div>
 </div>
 </div>
 <div class="col-lg-6">
 <div class="d-flex">
 <div class="icon-circle bg-warning text-white me-4"><i class="fas fa-plane-departure fa-2x"></i></div>
 <div>
 <h4 class="fw-bold">Holiday Planner</h4>
 <p class="text-muted">Plan trips with confidence. Know exactly how many classes you'll miss and the impact on your attendance.</p>
 </div>
 </div>
 </div>
 <div class="col-lg-6">
 <div class="d-flex">
 <div class="icon-circle bg-danger text-white me-4"><i class="fas fa-calendar-week fa-2x"></i></div>
 <div>
 <h4 class="fw-bold">Extended Weekend Finder</h4>
 <p class="text-muted">Automatically finds opportunities for long weekends based on holidays and your attendance status.</p>
 </div>
 </div>
 </div>
 <div class="col-lg-6">
 <div class="d-flex">
 <div class="icon-circle bg-primary text-white me-4"><i class="fas fa-users fa-2x"></i></div>
 <div>
 <h4 class="fw-bold">Student Connect</h4>
 <p class="text-muted">Find students traveling the same railway line as you. Build your campus network.</p>
 </div>
 </div>
 </div>
 <div class="col-lg-6">
 <div class="d-flex">
 <div class="icon-circle bg-success text-white me-4"><i class="fas fa-comments fa-2x"></i></div>
 <div>
 <h4 class="fw-bold">Campus Chat</h4>
 <p class="text-muted">Message your connections directly. Chat with study partners and friends on campus.</p>
 </div>
 </div>
 </div>
 <div class="col-lg-6">
 <div class="d-flex">
 <div class="icon-circle bg-warning text-white me-4"><i class="fas fa-crown fa-2x"></i></div>
 <div>
 <h4 class="fw-bold">Premium Insights</h4>
 <p class="text-muted">Advanced predictions, detailed monthly reports, and AI-style insights for serious students.</p>
 </div>
 </div>
 </div>
 </div>
 </div>
</section>

<section class="py-5" style="background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);">
 <div class="container text-center text-white">
 <h2 class="fw-bold mb-3">Ready to take control of your attendance?</h2>
 <p class="lead text-white-50 mb-4">Join thousands of students using Attendly to stay ahead.</p>
 <a asp-controller="Account" asp-action="Register" class="btn btn-warning btn-lg px-5">Get Started Free</a>
 </div>
</section>
