@model List<Attendly.ViewModels.ExtendedWeekendViewModel>
@{
 ViewData["Title"] = "Holiday Planner";
 }

<div class="container-fluid px-4 py-4" style="background: #f0f2f5; min-height: 100vh;">
 <div class="d-flex justify-content-between align-items-center mb-4">
 <h3 class="fw-bold"><i class="fas fa-plane-departure text-success me-2"></i>Extended Weekend Planner</h3>
 <a asp-controller="Planner" asp-action="Simulate" class="btn btn-primary">
 <i class="fas fa-calculator me-1"></i>Plan a Trip
 </a>
 </div>

 <div class="alert alert-info border-0">
 <i class="fas fa-info-circle me-2"></i>
 <strong>Smart Planning:</strong> We analyze upcoming holidays, your timetable, and attendance to find safe extended weekend opportunities.
 </div>

 @if (Model.Any())
 {
 <div class="row g-4">
 @foreach (var opp in Model)
 {
 <div class="col-lg-6">
 <div class="card border-0 shadow-sm h-100 @(opp.IsSafe ? "border-start border-success border-4" : "border-start border-danger border-4")">
 <div class="card-body">
 <div class="d-flex justify-content-between align-items-start">
 <div>
 <h5 class="fw-bold">@opp.HolidayName</h5>
 <p class="text-muted mb-0">@opp.WeekendStart.ToString("MMM dd") - @opp.WeekendEnd.ToString("MMM dd, yyyy")</p>
 </div>
 <span class="badge bg-@(opp.IsSafe ? "success" : "danger") fs-6">@opp.ProjectedAttendance.ToString("F1")%</span>
 </div>
 <div class="mt-3">
 <p class="mb-1"><strong>@opp.LecturesMissed lectures</strong> would be missed.</p>
 @if (opp.SubjectsAffected.Any())
 {
 <p class="text-muted small mb-0">Subjects: @string.Join(", ", opp.SubjectsAffected)</p>
 }
 </div>
 <div class="mt-3 alert alert-@(opp.IsSafe ? "success" : "danger") border-0 py-2">
 <i class="fas fa-@(opp.IsSafe ? "check" : "exclamation-triangle") me-1"></i>
 @if (opp.IsSafe)
 {
 <span>This extended weekend is <strong>safe</strong> — you'll stay above your attendance target.</span>
 }
 else
 {
 <span><strong>Warning:</strong> This may push you below your attendance target. Consider your options.</span>
 }
 </div>
 </div>
 </div>
 </div>
 }
 </div>
 }
 else
 {
 <div class="text-center py-5">
 <i class="fas fa-plane fa-3x text-muted mb-3"></i>
 <h4>No upcoming opportunities found</h4>
 <p class="text-muted">Check back after adding a timetable and subjects.</p>
 <a asp-action="Simulate" class="btn btn-primary mt-2">Plan a Custom Trip</a>
 </div>
 }
</div>
