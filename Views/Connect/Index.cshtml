@model List<Attendly.ViewModels.StudentDirectoryViewModel>
@{
 ViewData["Title"] = (ViewBag.LineLabel ?? "Western Line") + " - Connect";
 var line = ViewBag.RailwayLine ?? "western";
 }

<div class="container-fluid px-4 py-4" style="background: #f0f2f5; min-height: 100vh;">
 <div class="d-flex justify-content-between align-items-center mb-4">
 <div>
 <h3 class="fw-bold"><i class="fas fa-train text-primary me-2"></i>@ViewBag.LineLabel</h3>
 <p class="text-muted mb-0">Connect with students traveling the same line as you.</p>
 </div>
 <div class="btn-group">
 <a asp-action="Index" asp-route-line="western" class="btn btn-outline-primary @(line == "western" ? "active" : "")">Western Line</a>
 <a asp-action="Index" asp-route-line="central" class="btn btn-outline-primary @(line == "central" ? "active" : "")">Central Line</a>
 </div>
 </div>

 <div class="card border-0 shadow-sm mb-4">
 <div class="card-body">
 <form method="get" asp-action="Index" class="row g-3">
 <input type="hidden" name="line" value="@line" />
 <div class="col-md-3">
 <input name="search" class="form-control" placeholder="Search students..." value="@ViewBag.SearchQuery" />
 </div>
 <div class="col-md-2">
 <select name="college" class="form-select">
 <option value="">All Colleges</option>
 @foreach (var c in ViewBag.Colleges as List<string> ?? new())
 {
 <option value="@c" selected="@(c == ViewBag.FilterCollege)">@c</option>
 }
 </select>
 </div>
 <div class="col-md-2">
 <select name="course" class="form-select">
 <option value="">All Courses</option>
 @foreach (var c in ViewBag.Courses as List<string> ?? new())
 {
 <option value="@c" selected="@(c == ViewBag.FilterCourse)">@c</option>
 }
 </select>
 </div>
 <div class="col-md-2">
 <select name="station" class="form-select">
 <option value="">All Stations</option>
 @foreach (var s in ViewBag.Stations as List<string> ?? new())
 {
 <option value="@s" selected="@(s == ViewBag.FilterStation)">@s</option>
 }
 </select>
 </div>
 <div class="col-md-2">
 <button type="submit" class="btn btn-primary w-100">Filter</button>
 </div>
 </form>
 </div>
 </div>

 <div class="row g-4">
 @foreach (var student in Model)
 {
 <div class="col-md-6 col-xl-4">
 <div class="card border-0 shadow-sm h-100">
 <div class="card-body text-center">
 <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background: linear-gradient(135deg, #6366f1, #8b5cf6); font-size: 2rem; color: white;">
 @if (!string.IsNullOrEmpty(student.ProfileImageUrl))
 {
 <img src="@student.ProfileImageUrl" alt="" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover;" />
 }
 else
 {
 @student.FullName.Substring(0, 1).ToUpper()
 }
 </div>
 <h5 class="fw-bold">@student.FullName</h5>
 <p class="text-muted small mb-2">@student.Course · @student.Year</p>
 <p class="text-muted small mb-2"><i class="fas fa-map-marker-alt me-1"></i>@student.Station</p>
 <p class="text-muted small">@student.College</p>
 @if (student.ConnectionStatus == "none")
 {
 <form asp-action="SendRequest" asp-route-id="@student.Id" method="post" class="mt-3">
 <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-user-plus me-1"></i>Connect</button>
 </form>
 }
 else if (student.ConnectionStatus == "pending")
 {
 <span class="badge bg-warning mt-3"><i class="fas fa-clock me-1"></i>Pending</span>
 }
 else
 {
 <span class="badge bg-success mt-3"><i class="fas fa-check me-1"></i>Connected</span>
 }
 </div>
 </div>
 </div>
 }
 </div>

 @if (!Model.Any())
 {
 <div class="text-center py-5">
 <i class="fas fa-users fa-3x text-muted mb-3"></i>
 <h4>No students found</h4>
 <p class="text-muted">Try adjusting your filters or search.</p>
 </div>
 }
</div>
