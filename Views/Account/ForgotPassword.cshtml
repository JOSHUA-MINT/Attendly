@model Attendly.ViewModels.ForgotPasswordViewModel
@{
 ViewData["Title"] = "Forgot Password";
 }

<div class="auth-page d-flex align-items-center justify-content-center" style="min-height: 100vh; background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);">
 <div class="card shadow-lg border-0" style="width: 100%; max-width: 420px; border-radius: 16px;">
 <div class="card-body p-5">
 <div class="text-center mb-4">
 <i class="fas fa-key fa-3x text-primary mb-3"></i>
 <h3 class="fw-bold">Reset Password</h3>
 <p class="text-muted">Enter your email to receive reset instructions</p>
 </div>

 @if (TempData["Info"] != null)
 {
 <div class="alert alert-info">@TempData["Info"]</div>
 }

 <form asp-action="ForgotPassword" method="post">
 <div class="mb-3">
 <label class="form-label">Email</label>
 <div class="input-group">
 <span class="input-group-text"><i class="fas fa-envelope"></i></span>
 <input asp-for="Email" class="form-control" type="email" placeholder="you@college.edu" />
 </div>
 </div>
 <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
 </form>
 <div class="text-center mt-3">
 <a asp-action="Login" class="text-decoration-none small text-muted">Back to login</a>
 </div>
 </div>
 </div>
</div>
